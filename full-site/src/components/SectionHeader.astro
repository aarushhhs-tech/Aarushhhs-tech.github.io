---
interface Props {
  index: string;
  title: string;
}
const { index, title } = Astro.props;
---

<div class="section-header" data-reveal>
  <span class="mono">{index}</span>
  <h2>{title}</h2>
  <span class="rule" aria-hidden="true"></span>
</div>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    align-self: center;
  }
  @media (max-width: 420px) {
    h2 {
      white-space: normal;
    }
  }
</style>
