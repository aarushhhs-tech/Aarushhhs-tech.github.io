---
import Layout from '../../layouts/Layout.astro';
import { resumeData } from '../../data/resume';

export async function getStaticPaths() {
  return resumeData.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Aarush Sharma`} description={project.shortDescription}>
  <main class="detail-shell">
    <a href="/" class="back-link">← Back to portfolio</a>
    <article class="detail-card">
      <p class="detail-kicker">PROJECT / {project.date}</p>
      <h1>{project.title}</h1>
      <p class="detail-meta">{project.role} <span aria-hidden="true">·</span> {project.date}</p>
      <p class="detail-description">{project.longDescription}</p>
      <h2>Technologies & tools</h2>
      <div class="detail-tags">
        {project.technologies.map((tech) => <span class="tag">{tech}</span>)}
      </div>
      <div class="detail-actions">
        {project.link && <a class="button button-primary" href={project.link} target="_blank" rel="noopener noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>}
        <a class="button button-secondary" href="/">More projects <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  </main>
</Layout>
