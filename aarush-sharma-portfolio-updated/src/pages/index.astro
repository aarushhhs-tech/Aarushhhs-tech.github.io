---
import Layout from '../layouts/Layout.astro';
import { resumeData } from '../data/resume';
---

<Layout title="Aarush Sharma — Portfolio">
  <main class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12 border-b pb-6">
      <h1 class="text-4xl font-extrabold tracking-tight mb-2">{resumeData.name}</h1>
      <p class="text-xl text-gray-600 mb-4">{resumeData.title}</p>
      <div class="flex gap-4 text-sm text-blue-600">
        <a href={resumeData.contact.github} target="_blank" class="hover:underline">GitHub</a>
        <a href={resumeData.contact.linkedin} target="_blank" class="hover:underline">LinkedIn</a>
      </div>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">Current & Recent Projects</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {resumeData.projects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1"
            transition:name={`project-card-${project.slug}`}
          >
            <div class="flex justify-between items-start mb-2">
              <h3 
                class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition"
                transition:name={`project-title-${project.slug}`}
              >
                {project.title}
              </h3>
            </div>
            <p class="text-xs font-semibold text-blue-600 mb-3">{project.date}</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{project.shortDescription}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map((tech) => (
                <span class="bg-gray-100 text-gray-700 text-xs px-2.5 py-1 rounded-md font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
