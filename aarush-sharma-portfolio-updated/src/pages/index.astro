---
import Layout from '../layouts/Layout.astro';
import { resumeData } from '../data/resume';

const newestProjects = [...resumeData.projects].sort((a, b) => {
  const aCurrent = /present|current/i.test(a.date) ? 1 : 0;
  const bCurrent = /present|current/i.test(b.date) ? 1 : 0;
  return bCurrent - aCurrent;
});
---

<Layout title="Aarush Sharma — Engineering & Software Portfolio">
  <main class="site-shell" id="top">
    <nav class="topbar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="Aarush Sharma home"><span class="brand-mark">A.</span><span>Aarush Sharma</span></a>
      <div class="nav-links">
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> ENGINEERING × SOFTWARE</p>
        <h1>Building useful things at the intersection of <span class="gradient-text">science and code.</span></h1>
        <p class="hero-description">I'm {resumeData.name}, an {resumeData.title.toLowerCase()} focused on practical tools, thoughtful problem-solving, and turning complex workflows into simpler experiences.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">Explore projects <span aria-hidden="true">↘</span></a>
          <a class="button button-secondary" href={resumeData.contact.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta">
          <span><span class="meta-icon">⌘</span> Python & web tools</span>
          <span><span class="meta-icon">✳</span> Engineering-minded</span>
        </div>
      </div>
      <div class="hero-art" aria-label="Decorative abstract grid illustration">
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="art-core"><span>AS</span><i></i></div>
        <span class="art-label label-top">IDEAS → IMPACT</span>
        <span class="art-label label-bottom">DESIGN · BUILD · REFINE</span>
        <span class="art-spark spark-one">✳</span>
        <span class="art-spark spark-two">+</span>
      </div>
    </section>

    <section class="section projects-section" id="projects">
      <div class="section-heading">
        <div><p class="eyebrow">SELECTED WORK</p><h2>Projects<span class="heading-period">.</span></h2></div>
        <p class="section-note">Select any project card to expand its overview, tools, and links. Current work is listed first.</p>
      </div>
      <div class="project-grid">
        {newestProjects.map((project, index) => (
          <details class="project-card project-accordion">
            <summary class="project-summary">
              <div class="project-card-top">
                <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="project-date">{project.date}</span>
              </div>
              <h3>{project.title}</h3>
              <p class="project-description">{project.shortDescription}</p>
              <div class="tag-list">
                {project.technologies.map((tech) => <span class="tag">{tech}</span>)}
              </div>
              <span class="expand-hint"><span class="closed-hint">Open project details +</span><span class="open-hint">Close details −</span></span>
            </summary>
            <div class="expanded-project">
              <p class="expanded-label">OVERVIEW</p>
              <p>{project.longDescription}</p>
              <p class="expanded-role"><strong>Role:</strong> {project.role}</p>
              <div class="expanded-links">
                <a class="text-link" href={`/projects/${project.slug}`}>Full project page <span aria-hidden="true">↗</span></a>
                {project.link && <a class="text-link" href={project.link} target="_blank" rel="noopener noreferrer">Source on GitHub <span aria-hidden="true">↗</span></a>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <div class="section-heading">
        <div><p class="eyebrow">WHAT I'VE BEEN BUILDING</p><h2>Experience & project roles<span class="heading-period">.</span></h2></div>
        <p class="section-note">Expand an entry to read more about the work. These entries reflect the project roles currently listed in my portfolio.</p>
      </div>
      <div class="experience-list">
        {newestProjects.map((project) => (
          <details class="experience-item">
            <summary>
              <span class="experience-marker" aria-hidden="true"></span>
              <span class="experience-main"><span class="experience-role">{project.role}</span><span class="experience-title">{project.title}</span></span>
              <span class="experience-date">{project.date}</span>
              <span class="experience-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="experience-expanded">
              <p>{project.longDescription}</p>
              <div class="tag-list">{project.technologies.map((tech) => <span class="tag">{tech}</span>)}</div>
              <a class="text-link" href={`/projects/${project.slug}`}>View project details <span aria-hidden="true">↗</span></a>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="section about-section" id="about">
      <div class="about-mark" aria-hidden="true">{"{ }"}</div>
      <div class="about-copy">
        <p class="eyebrow">A LITTLE ABOUT ME</p>
        <h2>Curiosity first.<br /><span class="muted-heading">Make it work. Make it clear.</span></h2>
        <p>I enjoy combining analytical thinking with software development to build tools that are useful, understandable, and easy to use. My current projects span engineering chemistry calculations and document automation.</p>
        <div class="focus-list">
          <span>01 / Problem solving</span><span>02 / Python & automation</span><span>03 / Web development</span>
        </div>
      </div>
    </section>

    <section class="contact-panel" id="contact">
      <div><p class="eyebrow">HAVE A PROJECT IN MIND?</p><h2>Let's build something useful.</h2><p>Explore my work or connect with me online.</p></div>
      <div class="contact-actions">
        <a class="button button-light" href={resumeData.contact.github} target="_blank" rel="noopener noreferrer">Visit GitHub ↗</a>
        <a class="button button-outline-light" href={resumeData.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </section>

    <footer class="footer"><span>© {new Date().getFullYear()} {resumeData.name}</span><span>Designed with intention · Built with Astro</span><a href="#top">Back to top ↑</a></footer>
  </main>
</Layout>
