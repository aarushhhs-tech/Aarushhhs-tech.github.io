---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Aarush Sharma — Portfolio", description = "Engineering and software projects by Aarush Sharma." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d12" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{color-scheme:dark;--bg:#0b0d12;--panel:#12151d;--panel-hover:#171b25;--line:#262b38;--text:#f3f5fb;--muted:#a1a8b8;--accent:#a6f36b;--purple:#b9a2ff;--mono:'DM Mono',monospace;--sans:'Manrope',sans-serif}
      *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:15px;line-height:1.7;-webkit-font-smoothing:antialiased}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 75%);z-index:-1}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}button,a{-webkit-tap-highlight-color:transparent}.site-shell{width:min(1120px,calc(100% - 48px));margin:0 auto}.topbar{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:-.03em}.brand-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--accent);color:#10130d;font-size:15px}.nav-links{display:flex;gap:30px;color:var(--muted);font-size:13px}.nav-links a:hover,.footer a:hover{color:var(--accent)}.hero{min-height:560px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:74px 0 86px}.eyebrow{font:11px var(--mono);letter-spacing:.14em;color:var(--accent);margin:0 0 17px}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px #a6f36b88;margin-right:9px}.hero h1{font-size:clamp(40px,5.3vw,66px);line-height:1.1;letter-spacing:-.065em;margin:0;max-width:680px;font-weight:800}.gradient-text{color:var(--accent)}.hero-description{max-width:550px;color:var(--muted);font-size:16px;margin:24px 0 28px;line-height:1.9}.hero-actions,.contact-actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:12px 17px;border-radius:8px;font-size:13px;font-weight:800;transition:transform .2s,background .2s,border-color .2s}.button:hover{transform:translateY(-2px)}.button-primary{background:var(--accent);color:#10130d}.button-primary:hover{background:#bcff8b}.button-secondary{border:1px solid #3a4050;background:#151923}.button-secondary:hover{border-color:#747c8f}.hero-meta{display:flex;gap:23px;flex-wrap:wrap;margin-top:35px;color:#b8becc;font:11px var(--mono)}.meta-icon{color:var(--purple);margin-right:6px}.hero-art{position:relative;min-height:350px;display:grid;place-items:center;overflow:hidden}.hero-art:before{content:"";position:absolute;width:270px;height:270px;border-radius:50%;background:radial-gradient(circle,#a6f36b18,transparent 70%)}.art-orbit{position:absolute;border:1px solid #373e4e;border-radius:50%;transform:rotate(-25deg)}.orbit-one{width:280px;height:150px}.orbit-two{width:240px;height:310px;transform:rotate(42deg);border-color:#a6f36b48}.art-core{width:132px;height:132px;border:1px solid #a6f36b88;background:linear-gradient(145deg,#1a2519,#11141b);border-radius:34px;display:grid;place-items:center;transform:rotate(-9deg);box-shadow:0 0 70px #a6f36b14;position:relative}.art-core span{font-size:38px;font-weight:800;letter-spacing:-.08em;color:var(--accent);transform:rotate(9deg)}.art-core i{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--purple);right:14px;top:14px}.art-label{position:absolute;font:10px var(--mono);letter-spacing:.12em;color:#aab1c1}.label-top{top:30px;right:0}.label-bottom{bottom:31px;left:0}.art-spark{position:absolute;color:var(--accent);font-size:22px}.spark-one{left:12%;top:25%}.spark-two{right:13%;bottom:22%;color:var(--purple);font-size:28px}.section{padding:74px 0;border-top:1px solid var(--line)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:30px}.section-heading .eyebrow{margin-bottom:8px}.section h2,.contact-panel h2{font-size:clamp(28px,3.5vw,40px);line-height:1.2;letter-spacing:-.055em;margin:0;font-weight:800}.heading-period{color:var(--accent)}.section-note{color:var(--muted);font-size:13px;max-width:310px;margin:0 0 4px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.project-card{display:flex;flex-direction:column;min-height:315px;padding:25px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,#141821,#101219);transition:transform .25s,border-color .25s,background .25s}.project-card:hover{transform:translateY(-4px);border-color:#566345;background:linear-gradient(145deg,#181e22,#11141b)}.project-card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.project-index{font:12px var(--mono);color:var(--accent)}.project-date{font:10px var(--mono);color:#858d9f}.project-card h3{font-size:21px;line-height:1.35;letter-spacing:-.04em;margin:0 0 12px}.project-description{color:var(--muted);font-size:13px;line-height:1.85;margin:0 0 20px}.tag-list{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto}.tag{font:10px var(--mono);padding:5px 8px;border:1px solid #2d3341;border-radius:5px;color:#c1c7d4;background:#191d27}.project-links{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);margin-top:22px;padding-top:16px}.text-link{font-size:12px;font-weight:800}.text-link span{color:var(--accent);margin-left:6px}.icon-link{width:28px;height:28px;display:grid;place-items:center;border:1px solid #343a49;border-radius:7px;color:var(--accent)}.about-section{display:grid;grid-template-columns:.6fr 1.4fr;gap:60px;align-items:center}.about-mark{width:190px;height:190px;display:grid;place-items:center;border-radius:30px;border:1px solid #3c4650;background:radial-gradient(circle at 30% 25%,#a6f36b22,transparent 55%),#11151b;color:var(--accent);font:54px var(--mono);transform:rotate(-5deg);box-shadow:15px 15px 0 #151a22}.about-copy h2{margin-bottom:18px}.muted-heading{color:#81899a}.about-copy>p:not(.eyebrow){color:var(--muted);max-width:650px;font-size:14px}.focus-list{display:flex;gap:20px;flex-wrap:wrap;margin-top:25px;color:#c5cbd6;font:10px var(--mono)}.focus-list span{padding-top:10px;border-top:1px solid #343a48}.contact-panel{display:flex;align-items:center;justify-content:space-between;gap:25px;margin:45px 0 0;padding:38px;border:1px solid #394332;border-radius:16px;background:radial-gradient(ellipse at 90% 10%,#a6f36b12,transparent 50%),#121710}.contact-panel .eyebrow{margin-bottom:10px}.contact-panel h2{font-size:clamp(24px,3vw,34px)}.contact-panel p:not(.eyebrow){color:var(--muted);font-size:13px;margin:9px 0 0}.button-light{background:var(--accent);color:#10130d;white-space:nowrap}.button-outline-light{border:1px solid #485342;white-space:nowrap}.footer{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:25px 0 32px;color:#7f8798;font:10px var(--mono)}.footer a{color:#b9c0ce}.detail-shell{width:min(850px,calc(100% - 48px));margin:0 auto;padding:45px 0 70px}.back-link{display:inline-flex;color:var(--accent);font-size:12px;margin:0 0 25px}.detail-card{padding:clamp(25px,5vw,48px);border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#151923,#101219)}.detail-kicker{font:11px var(--mono);color:var(--accent);letter-spacing:.12em;margin:0 0 15px}.detail-card h1{font-size:clamp(30px,5vw,48px);letter-spacing:-.055em;line-height:1.15;margin:0 0 15px}.detail-meta{color:var(--muted);font-size:12px}.detail-description{font-size:16px;line-height:1.95;color:#c2c8d5;margin:30px 0}.detail-card h2{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#d9deea;margin:0 0 14px}.detail-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:30px}.detail-tags .tag{font-size:11px;padding:7px 10px}.detail-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px;padding-top:25px;border-top:1px solid var(--line)}
      @media(max-width:760px){.site-shell{width:min(100% - 34px,600px)}.topbar{height:70px}.nav-links{gap:15px;font-size:11px}.hero{grid-template-columns:1fr;padding:62px 0 55px;gap:10px}.hero h1{font-size:clamp(39px,11vw,58px)}.hero-art{min-height:270px}.section{padding:55px 0}.section-heading{align-items:flex-start;flex-direction:column;gap:12px}.project-grid{grid-template-columns:1fr}.project-card{min-height:280px}.about-section{grid-template-columns:1fr;gap:35px}.about-mark{width:125px;height:125px;font-size:40px;border-radius:23px}.contact-panel{align-items:flex-start;flex-direction:column;padding:27px 23px}.footer{gap:10px}.footer span:nth-child(2){order:3;width:100%}.detail-shell{width:calc(100% - 34px);padding-top:28px}}
      @media(max-width:390px){.nav-links{gap:10px}.nav-links a{font-size:10px}.brand{font-size:12px}.brand-mark{width:30px;height:30px}.hero-meta{gap:12px}.button{padding:11px 13px}.contact-actions{width:100%}.contact-actions .button{flex:1}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
