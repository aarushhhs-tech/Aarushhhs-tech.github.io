---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  profile,
  stats,
  experience,
  leadership,
  skills,
  education,
  coursework,
  languages,
} from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeHref = `${base}${profile.resume}`;
const year = new Date().getFullYear();

const slugify = (t: string) =>
  t.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const projectData = experience.map((e) => ({
  slug: slugify(e.org),
  org: e.org,
  role: e.role,
  dates: e.dates,
  accent: e.accent,
  points: e.points,
  tags: e.tags,
  details: e.details ?? '',
  links: e.links ?? [],
}));

const nav = [
  { href: '#experience', label: 'Experience' },
  { href: '#leadership', label: 'Leadership' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
];
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description={`${profile.name}: ${profile.summary}`}
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="#top" class="brand" aria-label="Back to top">
        <span class="brand-mark">AS</span>
        <span class="brand-name">{profile.name}</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-small" href="#contact">Contact</a>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="status" data-reveal>
          <span class="dot"></span>
          Currently building a go-kart with ASME at Texas A&amp;M
        </p>
        <h1 data-reveal>
          {profile.name}<span class="period">.</span>
        </h1>
        <p class="hero-role" data-reveal>
          {profile.role} at <strong>{profile.school}</strong>, focused on mechanical design,
          prototyping, and testing.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="btn" href={resumeHref} target="_blank" rel="noopener">
            View résumé
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
          <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
        </div>
        <dl class="meta" data-reveal>
          <div><dt class="mono">Based in</dt><dd>{profile.location}</dd></div>
          <div><dt class="mono">Studying</dt><dd>B.S. General Engineering</dd></div>
          <div><dt class="mono">Graduating</dt><dd>May 2030</dd></div>
        </dl>
      </div>
    </section>

    <!-- Stats -->
    <section class="container stats" aria-label="Highlights">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </section>

    <!-- About -->
    <section class="container section about" id="about">
      <SectionHeader index="01" title="About" />
      <p class="lede" data-reveal>
        {profile.summary} I enjoy the full loop of engineering — modeling a part in CAD, building it
        with my hands, watching it fail on the test stand, and iterating until it works.
      </p>
    </section>

    <!-- Experience -->
    <section class="container section" id="experience">
      <SectionHeader index="02" title="Engineering Experience" />
      <div class="exp-list">
        {
          experience.map((e) => (
            <article class={`exp-card accent-${e.accent}`} data-reveal data-project={slugify(e.org)}>
              <div class="exp-side">
                <span class="mono">{e.dates}</span>
              </div>
              <div class="exp-body">
                <h3>{e.org}</h3>
                <p class="exp-role">{e.role}</p>
                <ul class="points">
                  {e.points.map((p) => <li>{p}</li>)}
                </ul>
                <ul class="tags" aria-label="Topics">
                  {e.tags.map((t) => <li>{t}</li>)}
                </ul>
                <button class="exp-more" type="button" aria-haspopup="dialog">
                  View details
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Leadership -->
    <section class="container section" id="leadership">
      <SectionHeader index="03" title="Leadership" />
      <div class="lead-grid">
        {
          leadership.map((l) => (
            <article class="lead-card" data-reveal>
              <span class="mono">{l.dates}</span>
              <h3>{l.org}</h3>
              <p class="exp-role">{l.role}</p>
              <ul class="points">
                {l.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Skills -->
    <section class="container section" id="skills">
      <SectionHeader index="04" title="Technical Skills" />
      <div class="skill-grid">
        {
          skills.map((s) => (
            <div class={`skill-card accent-${s.accent}`} data-reveal>
              <h3 class="mono">{s.group}</h3>
              <ul class="chips">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section class="container section" id="education">
      <SectionHeader index="05" title="Education" />
      <div class="edu-grid">
        <div class="edu-list">
          {
            education.map((e) => (
              <div class="edu-row" data-reveal>
                <div>
                  <h3>{e.school}</h3>
                  <p class="exp-role">{e.degree} · {e.place}</p>
                </div>
                <span class="mono">{e.dates}</span>
              </div>
            ))
          }
        </div>
        <aside class="edu-aside" data-reveal>
          <div>
            <h4 class="mono">Relevant coursework</h4>
            <ul class="plain">
              {coursework.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div>
            <h4 class="mono">Languages</h4>
            <ul class="plain">
              {languages.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- Contact -->
    <section class="container contact" id="contact">
      <div class="contact-card" data-reveal>
        <p class="mono">Let's connect</p>
        <h2>Open to internships, research, and engineering projects.</h2>
        <div class="contact-links">
          <a class="btn btn-light" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn btn-outline-light" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-outline-light" href={resumeHref} target="_blank" rel="noopener">Résumé (PDF)</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="container footer">
    <span>© {year} {profile.name}</span>
    <span class="mono">{profile.location}</span>
  </footer>

  <!-- Project pop-up -->
  <script type="application/json" id="project-data" set:html={JSON.stringify(projectData)} />
  <dialog id="project-dialog" class="pd" aria-labelledby="pd-title">
    <div class="pd-panel">
      <div class="pd-top">
        <span class="mono" id="pd-count"></span>
        <button class="pd-close" type="button" aria-label="Close" data-pd-close>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="pd-content">
        <span class="mono" id="pd-dates"></span>
        <h2 id="pd-title"></h2>
        <p class="pd-role" id="pd-role"></p>
        <div class="pd-block" id="pd-details-wrap" hidden>
          <h4 class="mono">About</h4>
          <p id="pd-details"></p>
        </div>
        <div class="pd-block">
          <h4 class="mono">Highlights</h4>
          <ul class="pd-points" id="pd-points"></ul>
        </div>
        <div class="pd-block">
          <h4 class="mono">Skills &amp; topics</h4>
          <ul class="pd-tags" id="pd-tags"></ul>
        </div>
        <div class="pd-links" id="pd-links" hidden></div>
      </div>
      <div class="pd-nav">
        <button type="button" class="pd-step" id="pd-prev">← Previous</button>
        <button type="button" class="pd-step" id="pd-next">Next →</button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  type Project = {
    slug: string;
    org: string;
    role: string;
    dates: string;
    accent: string;
    points: string[];
    tags: string[];
    details: string;
    links: { label: string; url: string }[];
  };

  const dataEl = document.getElementById('project-data');
  const projects: Project[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const dlg = document.getElementById('project-dialog') as HTMLDialogElement | null;

  if (dlg && projects.length) {
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const panel = dlg.querySelector('.pd-panel') as HTMLElement;
    const content = dlg.querySelector('.pd-content') as HTMLElement;
    let current = 0;

    const fill = (ul: HTMLElement, items: string[]) => {
      ul.replaceChildren(
        ...items.map((t) => {
          const li = document.createElement('li');
          li.textContent = t;
          return li;
        })
      );
    };

    const render = (i: number, animate: boolean) => {
      current = (i + projects.length) % projects.length;
      const p = projects[current];
      dlg.dataset.accent = p.accent;
      $('pd-count').textContent = String(current + 1).padStart(2, '0') + ' / ' + String(projects.length).padStart(2, '0');
      $('pd-dates').textContent = p.dates;
      $('pd-title').textContent = p.org;
      $('pd-role').textContent = p.role;
      $('pd-details').textContent = p.details;
      $('pd-details-wrap').hidden = !p.details;
      fill($('pd-points'), p.points);
      fill($('pd-tags'), p.tags);
      const links = $('pd-links');
      links.replaceChildren(
        ...p.links.map((l) => {
          const a = document.createElement('a');
          a.className = 'btn btn-small';
          a.href = l.url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = l.label;
          return a;
        })
      );
      links.hidden = p.links.length === 0;
      $('pd-prev').hidden = $('pd-next').hidden = projects.length < 2;
      if (animate) {
        content.classList.remove('swap');
        void content.offsetWidth;
        content.classList.add('swap');
      }
      history.replaceState(null, '', '#project-' + p.slug);
    };

    // "expand into the project" morph (View Transitions API), with a graceful fallback
    const canMorph =
      typeof (document as any).startViewTransition === 'function' &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closing = false;

    const show = () => {
      if (!dlg.open) dlg.showModal();
      document.body.classList.add('modal-open');
      panel.scrollTop = 0;
    };

    const openAt = (i: number, fromCard?: HTMLElement | null) => {
      render(i, false);
      if (canMorph && fromCard && !dlg.open) {
        dlg.classList.add('vt');
        fromCard.style.setProperty('view-transition-name', 'project');
        const t = (document as any).startViewTransition(() => {
          fromCard.style.removeProperty('view-transition-name');
          panel.style.setProperty('view-transition-name', 'project');
          show();
        });
        t.finished.finally(() => dlg.classList.remove('vt'));
      } else {
        show();
      }
    };

    const close = () => {
      if (!dlg.open || closing) return;
      const card = document.querySelector<HTMLElement>(
        '.exp-card[data-project="' + projects[current].slug + '"]'
      );
      if (canMorph && card) {
        closing = true;
        dlg.classList.add('vt');
        const t = (document as any).startViewTransition(() => {
          panel.style.setProperty('view-transition-name', 'none');
          dlg.close();
          card.scrollIntoView({ block: 'nearest', behavior: 'instant' as ScrollBehavior });
          card.style.setProperty('view-transition-name', 'project');
        });
        t.finished.finally(() => {
          card.style.removeProperty('view-transition-name');
          dlg.classList.remove('vt');
          closing = false;
        });
      } else {
        dlg.close();
      }
    };

    // Esc key uses the same animated close
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    dlg.addEventListener('close', () => {
      document.body.classList.remove('modal-open');
      if (location.hash.startsWith('#project-')) history.replaceState(null, '', '#experience');
    });

    // open from a card (click anywhere on it, or its button)
    document.querySelectorAll<HTMLElement>('.exp-card[data-project]').forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        const idx = projects.findIndex((p) => p.slug === card.dataset.project);
        if (idx >= 0) openAt(idx, card);
      });
    });

    // close: X button, click on the dimmed area outside the panel
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.closest('[data-pd-close]')) close();
    });

    $('pd-prev').addEventListener('click', () => render(current - 1, true));
    $('pd-next').addEventListener('click', () => render(current + 1, true));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') render(current - 1, true);
      if (e.key === 'ArrowRight') render(current + 1, true);
    });

    // direct link, e.g. /#project-eco-car-team
    const fromHash = () => {
      const m = location.hash.match(/^#project-(.+)$/);
      if (!m) return;
      const idx = projects.findIndex((p) => p.slug === m[1]);
      if (idx >= 0) openAt(idx);
    };
    fromHash();
  }
</script>

<style>
  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
    font-size: 0.95rem;
    border: 1px solid var(--ink);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn-small {
    padding: 8px 16px;
    font-size: 0.875rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .btn-ghost:hover {
    border-color: var(--ink);
  }
  .btn-light {
    background: var(--sky);
    color: #0b0b0c;
    border-color: var(--sky);
  }
  .btn-outline-light {
    background: transparent;
    color: #fafaf9;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-outline-light:hover {
    border-color: #fafaf9;
  }

  /* ---------- Nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 700;
    position: relative;
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -3px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sky);
    border: 2px solid var(--bg);
  }
  .nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav ul a:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .nav nav {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .brand-name {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 20%, transparent 75%);
    opacity: 0.7;
  }
  .hero-bg::before,
  .hero-bg::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }
  .hero-bg::before {
    width: 420px;
    height: 420px;
    right: 6%;
    top: -80px;
    background: var(--sky);
  }
  .hero-bg::after {
    width: 300px;
    height: 300px;
    right: 26%;
    top: 160px;
    background: var(--lilac);
  }
  .hero-inner {
    position: relative;
    padding-top: 112px;
    padding-bottom: 88px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5fd08c;
    box-shadow: 0 0 0 4px var(--mint);
    flex-shrink: 0;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0 0 24px;
    transition-delay: 60ms;
  }
  .period {
    color: #7cc4f5;
  }
  .hero-role {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0 0 36px;
    line-height: 1.45;
    font-weight: 400;
    transition-delay: 120ms;
  }
  .hero-role strong {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 64px;
    transition-delay: 180ms;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 56px;
    margin: 0;
    transition-delay: 240ms;
  }
  .meta dt {
    margin-bottom: 4px;
  }
  .meta dd {
    margin: 0;
    font-weight: 500;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .stat {
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid var(--line);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-value {
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat {
      border-left: 0;
      padding: 24px 0;
      border-top: 1px solid var(--line);
    }
    .stat:first-child {
      border-top: 0;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: 112px;
  }
  .lede {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    max-width: 30em;
    margin: 0;
    color: var(--ink);
  }
  h3 {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.3;
  }
  .exp-role {
    color: var(--muted);
    margin: 4px 0 0;
    font-size: 0.95rem;
  }
  .points {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--ink-2);
  }
  .points li {
    position: relative;
    padding-left: 20px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--muted);
  }

  /* accents */
  .accent-sky {
    --accent: var(--sky);
    --accent-ink: var(--sky-ink);
  }
  .accent-mint {
    --accent: var(--mint);
    --accent-ink: var(--mint-ink);
  }
  .accent-peach {
    --accent: var(--peach);
    --accent-ink: var(--peach-ink);
  }
  .accent-lilac {
    --accent: var(--lilac);
    --accent-ink: var(--lilac-ink);
  }

  /* ---------- Experience ---------- */
  .exp-list {
    display: grid;
    gap: 16px;
  }
  .exp-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: relative;
