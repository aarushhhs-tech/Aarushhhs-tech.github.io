---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  profile,
  stats,
  experience,
  leadership,
  skills,
  education,
  coursework,
  languages,
} from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeHref = `${base}${profile.resume}`;
const year = new Date().getFullYear();

const nav = [
  { href: '#experience', label: 'Experience' },
  { href: '#leadership', label: 'Leadership' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
];
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description={`${profile.name}: ${profile.summary}`}
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="#top" class="brand" aria-label="Back to top">
        <span class="brand-mark">AS</span>
        <span class="brand-name">{profile.name}</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-small" href="#contact">Contact</a>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="status" data-reveal>
          <span class="dot"></span>
          Currently building a go-kart with ASME at Texas A&amp;M
        </p>
        <h1 data-reveal>
          {profile.name}<span class="period">.</span>
        </h1>
        <p class="hero-role" data-reveal>
          {profile.role} at <strong>{profile.school}</strong>, focused on mechanical design,
          prototyping, and testing.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="btn" href={resumeHref} target="_blank" rel="noopener">
            View résumé
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
          <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
        </div>
        <dl class="meta" data-reveal>
          <div><dt class="mono">Based in</dt><dd>{profile.location}</dd></div>
          <div><dt class="mono">Studying</dt><dd>B.S. General Engineering</dd></div>
          <div><dt class="mono">Graduating</dt><dd>May 2030</dd></div>
        </dl>
      </div>
    </section>

    <!-- Stats -->
    <section class="container stats" aria-label="Highlights">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </section>

    <!-- About -->
    <section class="container section about" id="about">
      <SectionHeader index="01" title="About" />
      <p class="lede" data-reveal>
        {profile.summary} I enjoy the full loop of engineering — modeling a part in CAD, building it
        with my hands, watching it fail on the test stand, and iterating until it works.
      </p>
    </section>

    <!-- Experience -->
    <section class="container section" id="experience">
      <SectionHeader index="02" title="Engineering Experience" />
      <div class="exp-list">
        {
          experience.map((e) => (
            <article class={`exp-card accent-${e.accent}`} data-reveal>
              <div class="exp-side">
                <span class="mono">{e.dates}</span>
              </div>
              <div class="exp-body">
                <h3>{e.org}</h3>
                <p class="exp-role">{e.role}</p>
                <ul class="points">
                  {e.points.map((p) => <li>{p}</li>)}
                </ul>
                <ul class="tags" aria-label="Topics">
                  {e.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Leadership -->
    <section class="container section" id="leadership">
      <SectionHeader index="03" title="Leadership" />
      <div class="lead-grid">
        {
          leadership.map((l) => (
            <article class="lead-card" data-reveal>
              <span class="mono">{l.dates}</span>
              <h3>{l.org}</h3>
              <p class="exp-role">{l.role}</p>
              <ul class="points">
                {l.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Skills -->
    <section class="container section" id="skills">
      <SectionHeader index="04" title="Technical Skills" />
      <div class="skill-grid">
        {
          skills.map((s) => (
            <div class={`skill-card accent-${s.accent}`} data-reveal>
              <h3 class="mono">{s.group}</h3>
              <ul class="chips">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section class="container section" id="education">
      <SectionHeader index="05" title="Education" />
      <div class="edu-grid">
        <div class="edu-list">
          {
            education.map((e) => (
              <div class="edu-row" data-reveal>
                <div>
                  <h3>{e.school}</h3>
                  <p class="exp-role">{e.degree} · {e.place}</p>
                </div>
                <span class="mono">{e.dates}</span>
              </div>
            ))
          }
        </div>
        <aside class="edu-aside" data-reveal>
          <div>
            <h4 class="mono">Relevant coursework</h4>
            <ul class="plain">
              {coursework.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div>
            <h4 class="mono">Languages</h4>
            <ul class="plain">
              {languages.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- Contact -->
    <section class="container contact" id="contact">
      <div class="contact-card" data-reveal>
        <p class="mono">Let's connect</p>
        <h2>Open to internships, research, and engineering projects.</h2>
        <div class="contact-links">
          <a class="btn btn-light" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn btn-outline-light" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-outline-light" href={resumeHref} target="_blank" rel="noopener">Résumé (PDF)</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="container footer">
    <span>© {year} {profile.name}</span>
    <span class="mono">{profile.location}</span>
  </footer>
</Layout>

<style>
  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
    font-size: 0.95rem;
    border: 1px solid var(--ink);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn-small {
    padding: 8px 16px;
    font-size: 0.875rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .btn-ghost:hover {
    border-color: var(--ink);
  }
  .btn-light {
    background: var(--sky);
    color: #0b0b0c;
    border-color: var(--sky);
  }
  .btn-outline-light {
    background: transparent;
    color: #fafaf9;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-outline-light:hover {
    border-color: #fafaf9;
  }

  /* ---------- Nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 700;
    position: relative;
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -3px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sky);
    border: 2px solid var(--bg);
  }
  .nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav ul a:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .nav nav {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .brand-name {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 20%, transparent 75%);
    opacity: 0.7;
  }
  .hero-bg::before,
  .hero-bg::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }
  .hero-bg::before {
    width: 420px;
    height: 420px;
    right: 6%;
    top: -80px;
    background: var(--sky);
  }
  .hero-bg::after {
    width: 300px;
    height: 300px;
    right: 26%;
    top: 160px;
    background: var(--lilac);
  }
  .hero-inner {
    position: relative;
    padding-top: 112px;
    padding-bottom: 88px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5fd08c;
    box-shadow: 0 0 0 4px var(--mint);
    flex-shrink: 0;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0 0 24px;
    transition-delay: 60ms;
  }
  .period {
    color: #7cc4f5;
  }
  .hero-role {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0 0 36px;
    line-height: 1.45;
    font-weight: 400;
    transition-delay: 120ms;
  }
  .hero-role strong {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 64px;
    transition-delay: 180ms;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 56px;
    margin: 0;
    transition-delay: 240ms;
  }
  .meta dt {
    margin-bottom: 4px;
  }
  .meta dd {
    margin: 0;
    font-weight: 500;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .stat {
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid var(--line);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-value {
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat {
      border-left: 0;
      padding: 24px 0;
      border-top: 1px solid var(--line);
    }
    .stat:first-child {
      border-top: 0;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: 112px;
  }
  .lede {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    max-width: 30em;
    margin: 0;
    color: var(--ink);
  }
  h3 {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.3;
  }
  .exp-role {
    color: var(--muted);
    margin: 4px 0 0;
    font-size: 0.95rem;
  }
  .points {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--ink-2);
  }
  .points li {
    position: relative;
    padding-left: 20px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--muted);
  }

  /* accents */
  .accent-sky {
    --accent: var(--sky);
    --accent-ink: var(--sky-ink);
  }
  .accent-mint {
    --accent: var(--mint);
    --accent-ink: var(--mint-ink);
  }
  .accent-peach {
    --accent: var(--peach);
    --accent-ink: var(--peach-ink);
  }
  .accent-lilac {
    --accent: var(--lilac);
    --accent-ink: var(--lilac-ink);
  }

  /* ---------- Experience ---------- */
  .exp-list {
    display: grid;
    gap: 16px;
  }
  .exp-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.25s,
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .exp-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--accent);
  }
  .exp-card:hover {
    border-color: var(--line-strong);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) var(--tag-mix), transparent);
    color: var(--accent-ink);
  }
  @media (max-width: 760px) {
    .exp-card {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 24px;
    }
  }

  /* ---------- Leadership ---------- */
  .lead-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .lead-card {
    padding: 32px 28px 8px;
    border-left: 1px solid var(--line);
  }
  .lead-card:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .lead-card h3 {
    margin-top: 14px;
  }
  .lead-card .points {
    font-size: 0.95rem;
  }
  @media (max-width: 860px) {
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-card {
      border-left: 0;
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
    }
  }

  /* ---------- Skills ---------- */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .skill-card {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .skill-card h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .skill-card h3::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.9rem;
    background: var(--bg);
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .chips li:hover {
    background: color-mix(in srgb, var(--accent) var(--tag-mix), transparent);
    border-color: var(--accent);
  }
  @media (max-width: 900px) {
    .skill-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Education ---------- */
  .edu-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
  }
  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .edu-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .edu-row .mono {
    white-space: nowrap;
  }
  .edu-aside {
    display: grid;
    gap: 28px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--peach) var(--panel-mix), var(--surface));
    border: 1px solid var(--line);
  }
  h4 {
    margin: 0 0 10px;
    font-weight: 500;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .edu-row {
      flex-direction: column;
      gap: 6px;
    }
  }

  /* ---------- Contact ---------- */
  .contact {
    padding-top: 112px;
  }
  .contact-card {
    position: relative;
    overflow: hidden;
    background: #0b0b0c;
    color: #fafaf9;
    border-radius: 22px;
    padding: clamp(32px, 6vw, 72px);
    border: 1px solid var(--line);
  }
  .contact-card::after {
    content: '';
    position: absolute;
    width: 360px;
    height: 360px;
    right: -100px;
    bottom: -160px;
    border-radius: 50%;
    background: var(--sky);
    filter: blur(90px);
    opacity: 0.35;
    pointer-events: none;
  }
  .contact-card .mono {
    color: #a1a1aa;
  }
  .contact-card h2 {
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 600;
    max-width: 18ch;
    margin: 12px 0 36px;
  }
  .contact-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- Footer ---------- */
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 40px;
    padding-bottom: 48px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .hero-inner {
      padding-top: 72px;
      padding-bottom: 56px;
    }
    .section,
    .contact {
      padding-top: 80px;
    }
  }
</style>
